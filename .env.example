# ─── Database ────────────────────────────────────────────────────────────────
# Local:  mysql://root@127.0.0.1:3306/freight_control
# Azure:  mysql://user:pass@server.mysql.database.azure.com:3306/freight_control?ssl=true
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/freight_control"

# ─── Auth ─────────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-secret"

# ─── Azure Blob Storage ───────────────────────────────────────────────────────
# Get from: Azure Portal → Storage Account → Access keys → Connection string
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=ACCOUNT;AccountKey=KEY;EndpointSuffix=core.windows.net"
AZURE_STORAGE_CONTAINER_NAME="freightcontrol"

SEED_ADMIN_NAME="Super Admin"
SEED_ADMIN_EMAIL="admin@freightcontrol.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"

EMAIL_DELIVERY_ENABLED=false
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_SECURE=

WHATSAPP_DELIVERY_ENABLED=false
WHATSAPP_PROVIDER=cloud_api
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v22.0
WHATSAPP_DEFAULT_LANGUAGE=en_US
WHATSAPP_WEB_QR_ENABLED=false

DELIVERY_DRY_RUN=true
COMMUNICATION_SECRET_KEY=

# Shared secret checked by /api/cron/notification-dispatch (x-dispatch-secret
# header). Required for the self-hosted cron job that auto-sends approved
# outbox deliveries; leave unset to keep the endpoint permanently closed.
NOTIFICATION_DISPATCH_SECRET=

# Shared secret checked by /api/cron/recurring-tasks (x-dispatch-secret
# header). Required for the self-hosted cron job that generates due
# recurring-task occurrences; leave unset to keep the endpoint permanently
# closed. Independent of NOTIFICATION_DISPATCH_SECRET -- each cron family
# uses its own secret.
RECURRING_TASK_DISPATCH_SECRET=

SMS_DELIVERY_ENABLED=false
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_BASE_URL=

# ─── AI Features ──────────────────────────────────────────────────────────────
# Platform-wide kill-switch. Must be "true" for any company to use AI features,
# regardless of that company's own AI Settings toggle. Leave false/unset to
# keep the whole AI module off for this installation.
AI_ENABLED=false
AI_PROVIDER=GEMINI
# Platform fallback key, used when a company has not saved its own key.
GOOGLE_GENERATIVE_AI_API_KEY=
AI_DEFAULT_DAILY_REQUEST_CAP=200
# Encrypts a company's own AI API key (Dashboard -> AI Settings). Required
# before any company can save its own key; independent of COMMUNICATION_SECRET_KEY.
AI_SECRET_KEY=

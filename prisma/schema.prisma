generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model account {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              user    @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Account_userId_fkey")

  @@unique([provider, providerAccountId], map: "Account_provider_providerAccountId_key")
  @@index([userId], map: "Account_userId_idx")
}

model approvalpolicy {
  id                   String    @id
  companyId            String
  documentType         approvalpolicy_documentType
  name                 String
  branchId             String?
  thresholdAmountBDT   Decimal   @db.Decimal(14, 2)
  approverRoleSequence String    @db.Text
  isActive             Boolean   @default(false)
  createdById          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime
  deletedAt            DateTime?
  company              company           @relation(fields: [companyId], references: [id], onDelete: Cascade, map: "ApprovalPolicy_companyId_fkey")
  branch               branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull, map: "ApprovalPolicy_branchId_fkey")
  user                 user?             @relation(fields: [createdById], references: [id], map: "ApprovalPolicy_createdById_fkey")
  approvalrequest      approvalrequest[]

  @@unique([companyId, documentType, branchId], map: "ApprovalPolicy_companyId_documentType_branchId_key")
  @@index([companyId, documentType, isActive], map: "ApprovalPolicy_companyId_documentType_isActive_idx")
}

model approvalrequest {
  id               String    @id
  companyId        String
  branchId         String
  policyId         String
  documentType     approvalpolicy_documentType
  vendorBillId     String?
  paymentId        String?
  status           approvalrequest_status @default(PENDING)
  currentSequence  Int       @default(1)
  amountBDT        Decimal   @db.Decimal(14, 2)
  submittedById    String
  submittedAt      DateTime  @default(now())
  decidedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime
  company          company          @relation(fields: [companyId], references: [id], onDelete: Cascade, map: "ApprovalRequest_companyId_fkey")
  branch           branch           @relation(fields: [branchId], references: [id], map: "ApprovalRequest_branchId_fkey")
  approvalpolicy   approvalpolicy   @relation(fields: [policyId], references: [id], map: "ApprovalRequest_policyId_fkey")
  vendorbill       vendorbill?      @relation(fields: [vendorBillId], references: [id], onDelete: Cascade, map: "ApprovalRequest_vendorBillId_fkey")
  payment          payment?         @relation(fields: [paymentId], references: [id], onDelete: Cascade, map: "ApprovalRequest_paymentId_fkey")
  user             user             @relation(fields: [submittedById], references: [id], map: "ApprovalRequest_submittedById_fkey")
  approvalstep     approvalstep[]
  approvaldecision approvaldecision[]

  @@index([companyId, status], map: "ApprovalRequest_companyId_status_idx")
  @@index([vendorBillId], map: "ApprovalRequest_vendorBillId_idx")
  @@index([paymentId], map: "ApprovalRequest_paymentId_idx")
}

model approvalstep {
  id               String    @id
  requestId        String
  sequence         Int
  approverRoleCode role_code
  status           approvalstep_status @default(PENDING)
  decidedById      String?
  decidedAt        DateTime?
  createdAt        DateTime  @default(now())
  approvalrequest  approvalrequest    @relation(fields: [requestId], references: [id], onDelete: Cascade, map: "ApprovalStep_requestId_fkey")
  user             user?              @relation(fields: [decidedById], references: [id], map: "ApprovalStep_decidedById_fkey")
  approvaldecision approvaldecision[]

  @@unique([requestId, sequence], map: "ApprovalStep_requestId_sequence_key")
  @@index([status, approverRoleCode], map: "ApprovalStep_status_approverRoleCode_idx")
}

model approvaldecision {
  id              String   @id
  requestId       String
  stepId          String
  decidedById     String
  decision        approvaldecision_decision
  remarks         String?  @db.Text
  createdAt       DateTime @default(now())
  approvalrequest approvalrequest @relation(fields: [requestId], references: [id], onDelete: Cascade, map: "ApprovalDecision_requestId_fkey")
  approvalstep    approvalstep    @relation(fields: [stepId], references: [id], onDelete: Cascade, map: "ApprovalDecision_stepId_fkey")
  user            user            @relation(fields: [decidedById], references: [id], map: "ApprovalDecision_decidedById_fkey")

  @@index([requestId], map: "ApprovalDecision_requestId_idx")
}

model auditlog {
  id         String   @id
  companyId  String?
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   String?  @db.LongText
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       user?    @relation(fields: [actorId], references: [id], map: "AuditLog_actorId_fkey")
  company    company? @relation(fields: [companyId], references: [id], map: "AuditLog_companyId_fkey")

  @@index([actorId], map: "AuditLog_actorId_idx")
  @@index([companyId], map: "AuditLog_companyId_idx")
  @@index([createdAt], map: "AuditLog_createdAt_idx")
  @@index([entityType, entityId], map: "AuditLog_entityType_entityId_idx")
}

model billoflading {
  id                        String                      @id
  companyId                 String
  shipmentJobId             String                      @unique(map: "BillOfLading_shipmentJobId_key")
  shippingInstructionId     String?                     @unique(map: "BillOfLading_shippingInstructionId_key")
  documentType              billoflading_documentType
  draftNumber               String?
  draftReceivedAt           DateTime?
  draftForwardedAt          DateTime?
  approvalStatus            billoflading_approvalStatus @default(NOT_RECEIVED)
  customerApprovalAt        DateTime?
  customerCorrectionRemarks String?                     @db.Text
  finalNumber               String?
  finalLocked               Boolean                     @default(false)
  finalLockedAt             DateTime?
  releaseType               billoflading_releaseType    @default(NOT_APPLICABLE)
  releaseStatus             billoflading_releaseStatus  @default(PENDING)
  releaseRequestedAt        DateTime?
  releaseConfirmedAt        DateTime?
  originalCopies            Int?
  releaseReference          String?
  paymentReceived           Boolean                     @default(false)
  notes                     String?                     @db.Text
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime
  company                   company                     @relation(fields: [companyId], references: [id], onDelete: Cascade, map: "BillOfLading_companyId_fkey")
  shipmentjob               shipmentjob                 @relation(fields: [shipmentJobId], references: [id], onDelete: Cascade, map: "BillOfLading_shipmentJobId_fkey")
  shippinginstruction       shippinginstruction?        @relation(fields: [shippingInstructionId], references: [id], map: "BillOfLading_shippingInstructionId_fkey")

  @@index([approvalStatus], map: "BillOfLading_approvalStatus_idx")
  @@index([companyId], map: "BillOfLading_companyId_idx")
  @@index([releaseStatus], map: "BillOfLading_releaseStatus_idx")
}

model cargoreleasechecklist {
  id                         String                       @id
  companyId                  String
  shipmentJobId              String                       @unique(map: "CargoReleaseChecklist_shipmentJobId_key")
  status                     cargoreleasechecklist_status @default(NOT_ARRIVED)
  arrived                    Boolean                      @default(false)
  arrivedAt                  DateTime?
  arrivalNoticeReceived      Boolean                      @default(false)
  arrivalNoticeAt            DateTime?
  consigneeDocumentsReceived Boolean                      @default(false)
  shipperPaymentConfirmed    Boolean                      @default(false)
  customerPaymentConfirmed   Boolean                      @default(false)
  bankBlAuthenticityVerified Boolean                      @default(false)
  originalBlReceived         Boolean                      @default(false)
  telexSurrenderConfirmed    Boolean                      @default(false)
  deliveryOrderReleased      Boolean                      @default(false)
  customsReady               Boolean                      @default(false)
  cargoReleased              Boolean                      @default(false)
  cargoReleasedAt            DateTime?
  delivered                  Boolean                      @default(false)
  deliveredAt                DateTime?
  holdReason                 String?                      @db.Text
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime
  consigneeContact           String?
  deliveredBy                String?
  deliveryAddress            String?                      @db.Text
  deliveryDateTime           DateTime?
  deliveryLocation           String?
  deliveryOrderNo            String?
  deliveryRemarks            String?                      @db.Text
  driverName                 String?
  driverPhone                String?
  exceptionReason            String?                      @db.Text
  gatePassNo                 String?
  podReferenceNo             String?
  releaseDate                DateTime?
  transportVendorId          String?
  truckVehicleNo             String?
  verifiedAt                 DateTime?
  verifiedBy                 String?
  warehouseName              String?
  outForDeliveryAt           DateTime?
  company                    company                      @relation(fields: [companyId], references: [id], onDelete: Cascade, map: "CargoReleaseChecklist_companyId_fkey")
  shipmentjob                shipmentjob                  @relation(fields: [shipmentJobId], references: [id], onDelete: Cascade, map: "CargoReleaseChecklist_shipmentJobId_fkey")

  @@index([companyId], map: "CargoReleaseChecklist_companyId_idx")
  @@index([status], map: "CargoReleaseChecklist_status_idx")
}

model carrierproposal {
  id                  String                   @id
  companyId           String
  carrierQueryId      String
  vendorId            String
  buyingFreightAmount Decimal                  @db.Decimal(14, 2)
  localCharges        Decimal                  @default(0.00) @db.Decimal(14, 2)
  currency            carrierproposal_currency
  validUntil          DateTime?
  transitTime         String?
  etd                 DateTime?
  eta                 DateTime?
  freeTime            String?
  routeNote           String?                  @db.Text
  terms               String?                  @db.Text
  providerReference   String?
  status              carrierproposal_status   @default(RECEIVED)
  selected            Boolean                  @default(false)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime
  deletedAt           DateTime?
  carrierquery        carrierquery             @relation(fields: [carrierQueryId], references: [id], onDelete: Cascade, map: "CarrierProposal_carrierQueryId_fkey")
  company             company                  @relation(fields: [companyId], references: [id], onDelete: Cascade, map: "CarrierProposal_companyId_fkey")
  vendor              vendor                   @relation(fields: [vendorId], references: [id], map: "CarrierProposal_vendorId_fkey")
  quotation           quotation[]

  @@index([carrierQueryId], map: "CarrierProposal_carrierQueryId_idx")
  @@index([companyId], map: "CarrierProposal_companyId_idx")
  @@index([selected], map: "CarrierProposal_selected_idx")
  @@index([status], map: "CarrierProposal_status_idx")
  @@index([vendorId], map: "CarrierProposal_vendorId_idx")
}

model carrierquery {
  id                   String              @id
  companyId            String
  shipmentRequestId    String?
  quotationId          String?
  shipmentJobId        String?
  vendorId             String
  mode                 carrierquery_mode
  origin               String
  destination          String
  cargoSummary         String              @db.Text
  hsCode               String?
  weight               Decimal?            @db.Decimal(12, 3)
  cbm                  Decimal?            @db.Decimal(12, 3)
  packageInfo          String?
  containerRequirement String?
  requestedDate        DateTime?
  status               carrierquery_status @default(DRAFT)
  querySentAt          DateTime?
  responseDueAt        DateTime?
  notes                String?             @db.Text
  createdAt            DateTime            @default(now())
  updatedAt            DateTime
  deletedAt            DateTime?
  carrierproposal      carrierproposal[]
  company              company             @relation(fields: [companyId], references: [id], onDelete: Cascade, map: "CarrierQuery_companyId_fkey")
  quotation            quotation?          @relation(fields: [quotationId], references: [id], map: "CarrierQuery_quotationId_fkey")
  shipmentjob          shipmentjob?        @relation(fields: [shipmentJobId], references: [id], map: "CarrierQuery_shipmentJobId_fkey")
  shipmentrequest      shipmentrequest?    @relation(fields: [shipmentRequestId], references: [id], map: "CarrierQuery_shipmentRequestId_fkey")
  vendor               vendor              @relation(fields: [vendorId], references: [id], map: "CarrierQuery_vendorId_fkey")

  @@index([companyId], map: "CarrierQuery_companyId_idx")
  @@index([quotationId], map: "CarrierQuery_quotationId_fkey")
  @@index([shipmentJobId], map: "CarrierQuery_shipmentJobId_idx")
  @@index([shipmentRequestId], map: "CarrierQuery_shipmentRequestId_idx")
  @@index([status], map: "CarrierQuery_status_idx")
  @@index([vendorId], map: "CarrierQuery_vendorId_idx")
}

model clientportalaccount {
  id                            String                          @id
  companyId                     String
  customerId                    String
  clientCode                    String
  displayClientCode             String
  email                         String?
  phone                         String?
  passwordHash                  String
  plainPassword                 String?
  status                        clientportalaccount_status      @default(ACTIVE)
  mustChangePassword            Boolean                         @default(true)
  lastLoginAt                   DateTime?
  createdById                   String?
  createdAt                     DateTime                        @default(now())
  updatedAt                     DateTime
  deletedAt                     DateTime?
  company                       company                         @relation(fields: [companyId], references: [id], onDelete: Cascade, map: "ClientPortalAccount_companyId_fkey")
  user                          user?                           @relation(fields: [createdById], references: [id], map: "ClientPortalAccount_createdById_fkey")
  customer                      customer                        @relation(fields: [customerId], references: [id], onDelete: Cascade, map: "ClientPortalAccount_customerId_fkey")
  customerportalactivationtoken customerportalactivationtoken[]
  documentapproval              documentapproval[]
  notification                  notification[]
  notificationdelivery          notificationdelivery[]
  shipmentrequest               shipmentrequest[]

  @@unique([companyId, clientCode], map: "ClientPortalAccount_companyId_clientCode_key")
  @@unique([companyId, displayClientCode], map: "ClientPortalAccount_companyId_displayClientCode_key")
  @@index([companyId], map: "ClientPortalAccount_companyId_idx")
  @@index([createdAt], map: "ClientPortalAccount_createdAt_idx")
  @@index([createdById], map: "ClientPortalAccount_createdById_fkey")
  @@index([customerId], map: "ClientPortalAccount_customerId_idx")
  @@index([email], map: "ClientPortalAccount_email_idx")
  @@index([phone], map: "ClientPortalAccount_phone_idx")
  @@index([status], map: "ClientPortalAccount_status_idx")
}

model clientportalsequence {
  id              String   @id
  companyId       String
  year            Int
  currentSequence Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime
  company         company  @relation(fields: [companyId], references: [id], onDelete: Cascade, map: "ClientPortalSequence_companyId_fkey")

  @@unique([companyId, year], map: "ClientPortalSequence_companyId_year_key")
  @@index([companyId], map: "ClientPortalSequence_companyId_idx")
}

model communicationaccount {
  id                        String                        @id
  companyId                 String
  userId                    String?
  provider                  communicationaccount_provider
  channel                   communicationaccount_channel
  displayName               String
  senderEmail               String?
  senderPhone               String?
  whatsappPhoneNumberId     String?
  whatsappBusinessAccountId String?
  status                    communicationaccount_status   @default(DISCONNECTED)
  isDefaultCompanyAccount   Boolean                       @default(false)
  isUserOwned               Boolean                       @default(false)
  lastConnectedAt           DateTime?
  lastError                 String?                       @db.Text
  encryptedConfig           String?                       @db.LongText
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime
  deletedAt                 DateTime?
  company                   company                       @relation(fields: [companyId], references: [id], onDelete: Cascade, map: "CommunicationAccount_companyId_fkey")
  user                      user?                         @relation(fields: [userId], references: [id], map: "CommunicationAccount_userId_fkey")
  notificationdelivery      notificationdelivery[]

  @@index([channel], map: "CommunicationAccount_channel_idx")
  @@index([companyId], map: "CommunicationAccount_companyId_idx")
  @@index([deletedAt], map: "CommunicationAccount_deletedAt_idx")
  @@index([provider], map: "CommunicationAccount_provider_idx")
  @@index([status], map: "CommunicationAccount_status_idx")
  @@index([userId], map: "CommunicationAccount_userId_idx")
}

model company {
  id                            String                          @id
  name                          String
  legalName                     String?
  email                         String?
  phone                         String?
  address                       String?
  status                        company_status                  @default(ACTIVE)
  createdAt                     DateTime                        @default(now())
  updatedAt                     DateTime
  deletedAt                     DateTime?
  deploymentType                company_deploymentType          @default(CLOUD)
  maxUsers                      Int?
  planType                      company_planType                @default(TRIAL)
  storageLimitMB                Int?
  subscriptionEndsAt            DateTime?
  subscriptionStatus            company_subscriptionStatus      @default(TRIAL)
  trialEndsAt                   DateTime?
  portalCodePrefix              String?
  portalDisplayName             String?
  portalEnabled                 Boolean                         @default(false)
  portalSlug                    String?                         @unique(map: "Company_portalSlug_key")
  logoMimeType                  String?
  logoPath                      String?
  logoUpdatedAt                 DateTime?
  hblAccountsLimit              Int                             @default(1)
  hblArchiveLimit               Int                             @default(1)
  hblCustomerLimit              Int                             @default(1)
  hblOfficeLimit                Int                             @default(1)
  hblOperationsLimit            Int                             @default(1)
  hblOriginalsLimit             Int                             @default(3)
  hblPrintWatermarkEnabled      Boolean                         @default(true)
  approvalpolicy                approvalpolicy[]
  approvalrequest               approvalrequest[]
  auditlog                      auditlog[]
  billoflading                  billoflading[]
  branch                        branch[]
  cargoreleasechecklist         cargoreleasechecklist[]
  carrierproposal               carrierproposal[]
  carrierquery                  carrierquery[]
  clientportalaccount           clientportalaccount[]
  clientportalsequence          clientportalsequence[]
  communicationaccount          communicationaccount[]
  companyaisettings             companyaisettings?
  companymoduleaccess           companymoduleaccess[]
  companysubscription           companysubscription?
  container                     container[]
  customer                      customer[]
  customerportalactivationtoken customerportalactivationtoken[]
  documentchecklistitem         documentchecklistitem[]
  documenttemplate              documenttemplate[]
  freightbooking                freightbooking[]
  freightdocument               freightdocument[]
  freightdocumentsequence       freightdocumentsequence[]
  importjob                     importjob[]
  invoice                       invoice[]
  invoiceline                   invoiceline[]
  invoicesequence               invoicesequence[]
  notification                  notification[]
  notificationdelivery          notificationdelivery[]
  notificationoptout            notificationoptout[]
  notificationtemplate          notificationtemplate[]
  payment                       payment[]
  paymentsequence               paymentsequence[]
  prealert                      prealert[]
  quotation                     quotation[]
  quotationcharge               quotationcharge[]
  quotationsequence             quotationsequence[]
  role                          role[]
  savedview                     savedview[]
  shipmentcostitem              shipmentcostitem[]
  shipmentdocument              shipmentdocument[]
  shipmentjob                   shipmentjob[]
  shipmentjobsequence           shipmentjobsequence[]
  shipmentrequest               shipmentrequest[]
  shipmentrequestsequence       shipmentrequestsequence[]
  shipmentstatusevent           shipmentstatusevent[]
  shipmentworkflowstep          shipmentworkflowstep[]
  shipmentworkflowtemplatestep  shipmentworkflowtemplatestep[]
  shippinginstruction           shippinginstruction[]
  stuffingplan                  stuffingplan[]
  task                          task[]
  taskcomment                   taskcomment[]
  taskrecurrence                taskrecurrence[]
  user                          user[]
  userdashboardlayout           userdashboardlayout[]
  vendor                        vendor[]
  vendorbill                    vendorbill[]
  vendorbillline                vendorbillline[]
  vendorbillsequence            vendorbillsequence[]
  workflowtemplate              workflowtemplate[]

  @@index([createdAt], map: "Company_createdAt_idx")
  @@index([planType], map: "Company_planType_idx")
  @@index([status], map: "Company_status_idx")
  @@index([subscriptionStatus], map: "Company_subscriptionStatus_idx")
}

model companyaisettings {
  id              String                      @id
  companyId       String                      @unique(map: "CompanyAiSettings_companyId_key")
  enabled         Boolean                     @default(false)
  provider        companyaisettings_provider?
  encryptedApiKey String?                     @db.LongText
  dailyRequestCap Int?
  lastTestedAt    DateTime?
  lastTestResult  String?                     @db.Text
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime
  company         company                     @relation(fields: [companyId], references: [id], onDelete: Cascade, map: "CompanyAiSettings_companyId_fkey")
}

model companymoduleaccess {
  id        String                        @id
  companyId String
  moduleKey companymoduleaccess_moduleKey
  isEnabled Boolean                       @default(true)
  createdAt DateTime                      @default(now())
  updatedAt DateTime
  company   company                       @relation(fields: [companyId], references: [id], onDelete: Cascade, map: "CompanyModuleAccess_companyId_fkey")

  @@unique([companyId, moduleKey], map: "CompanyModuleAccess_companyId_moduleKey_key")
  @@index([companyId], map: "CompanyModuleAccess_companyId_idx")
  @@index([isEnabled], map: "CompanyModuleAccess_isEnabled_idx")
  @@index([moduleKey], map: "CompanyModuleAccess_moduleKey_idx")
}

model companysubscription {
  id             String                             @id
  companyId      String                             @unique(map: "CompanySubscription_companyId_key")
  planType       companysubscription_planType       @default(TRIAL)
  deploymentType companysubscription_deploymentType @default(CLOUD)
  status         companysubscription_status         @default(TRIAL)
  startsAt       DateTime                           @default(now())
  trialEndsAt    DateTime?
  expiresAt      DateTime?
  maxUsers       Int?
  storageLimitMB Int?
  remarks        String?                            @db.Text
  createdAt      DateTime                           @default(now())
  updatedAt      DateTime
  company        company                            @relation(fields: [companyId], references: [id], onDelete: Cascade, map: "CompanySubscription_companyId_fkey")

  @@index([companyId], map: "CompanySubscription_companyId_idx")
  @@index([expiresAt], map: "CompanySubscription_expiresAt_idx")
  @@index([planType], map: "CompanySubscription_planType_idx")
  @@index([status], map: "CompanySubscription_status_idx")
}

model container {
  id                  String                        @id
  companyId           String
  shipmentJobId       String
  containerNo         String
  sealNo              String?
  containerType       String?
  packageCount        Int?
  grossWeight         Decimal?                      @db.Decimal(12, 3)
  cbm                 Decimal?                      @db.Decimal(12, 3)
  gateInDate          DateTime?
  gateOutDate         DateTime?
  freeTimeLastDate    DateTime?
  demurrageRiskStatus container_demurrageRiskStatus @default(NOT_APPLICABLE)
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime
  deletedAt           DateTime?
  cargoReceivedAt     DateTime?
  loadedAt            DateTime?
  loadingRemarks      String?                       @db.Text
  pickupDate          DateTime?
  company             company                       @relation(fields: [companyId], references: [id], onDelete: Cascade, map: "Container_companyId_fkey")
  shipmentjob         shipmentjob                   @relation(fields: [shipmentJobId], references: [id], onDelete: Cascade, map: "Container_shipmentJobId_fkey")

  @@index([companyId], map: "Container_companyId_idx")
  @@index([containerNo], map: "Container_containerNo_idx")
  @@index([createdAt], map: "Container_createdAt_idx")
  @@index([demurrageRiskStatus], map: "Container_demurrageRiskStatus_idx")
  @@index([shipmentJobId], map: "Container_shipmentJobId_idx")
}

model customer {
  id                            String                          @id
  companyId                     String
  name                          String
  code                          String?
  email                         String?
  phone                         String?
  address                       String?
  binOrVat                      String?
  status                        customer_status                 @default(ACTIVE)
  createdAt                     DateTime                        @default(now())
  updatedAt                     DateTime
  deletedAt                     DateTime?
  clientportalaccount           clientportalaccount[]
  company                       company                         @relation(fields: [companyId], references: [id], onDelete: Cascade, map: "Customer_companyId_fkey")
  customercontact               customercontact[]
  customerportalactivationtoken customerportalactivationtoken[]
  invoice                       invoice[]
  payment                       payment[]
  quotation                     quotation[]
  shipmentcostitem              shipmentcostitem[]
  shipmentjob                   shipmentjob[]
  shipmentrequest               shipmentrequest[]
  task                          task[]
  user                          user[]

  @@unique([companyId, code], map: "Customer_companyId_code_key")
  @@index([companyId], map: "Customer_companyId_idx")
  @@index([createdAt], map: "Customer_createdAt_idx")
  @@index([name], map: "Customer_name_idx")
  @@index([status], map: "Customer_status_idx")
}

model customercontact {
  id          String   @id
  customerId  String
  name        String
  email       String?
  phone       String?
  designation String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  customer    customer @relation(fields: [customerId], references: [id], onDelete: Cascade, map: "CustomerContact_customerId_fkey")

  @@index([customerId], map: "CustomerContact_customerId_idx")
}

model customerportalactivationtoken {
  id                    String              @id
  companyId             String
  customerId            String
  clientPortalAccountId String
  tokenHash             String              @unique(map: "CustomerPortalActivationToken_tokenHash_key")
  expiresAt             DateTime
  usedAt                DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime
  deletedAt             DateTime?
  clientportalaccount   clientportalaccount @relation(fields: [clientPortalAccountId], references: [id], onDelete: Cascade, map: "CustomerPortalActivationToken_clientPortalAccountId_fkey")
  company               company             @relation(fields: [companyId], references: [id], onDelete: Cascade, map: "CustomerPortalActivationToken_companyId_fkey")
  customer              customer            @relation(fields: [customerId], references: [id], onDelete: Cascade, map: "CustomerPortalActivationToken_customerId_fkey")

  @@index([clientPortalAccountId], map: "CustomerPortalActivationToken_clientPortalAccountId_idx")
